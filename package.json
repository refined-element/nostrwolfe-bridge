{
  "name": "nostrwolfe-bridge",
  "version": "0.3.2",
  "description": "A daemon that mirrors the NostrWolfe agent-services marketplace (Nostr kind:38400) into a Buzz community channel, and lets members publish their own listings out to it.",
  "type": "module",
  "license": "MIT",
  "author": "Lightning Enable (refined-element)",
  "homepage": "https://github.com/refined-element/nostrwolfe-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/refined-element/nostrwolfe-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/refined-element/nostrwolfe-bridge/issues"
  },
  "keywords": [
    "nostr",
    "nostrwolfe",
    "buzz",
    "lightning",
    "l402",
    "agent-commerce",
    "marketplace",
    "nip-29",
    "relay",
    "daemon"
  ],
  "bin": {
    "nostrwolfe-bridge": "bin/cli.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "bin",
    ".env.example",
    "DESIGN.md",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "nostr-tools": "^2.10.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
