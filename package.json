{
  "name": "nostrwolfe-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone daemon mirroring the NostrWolfe public marketplace (kind:38400) into a Buzz community Services channel.",
  "scripts": {
