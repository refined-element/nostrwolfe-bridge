# nostrwolfe-bridge configuration (spec §1)
# Copy to .env and fill in BRIDGE_NSEC.

# REQUIRED. bech32 nsec or 64-hex secret key.
# Signs AUTH (22242), channel create (9007), join (9021), messages (9), profile (0).
BRIDGE_NSEC=

# Buzz relay. Local dev default; hosted communities use wss://<community-host>
# (the AUTH relay tag must match the exact host being dialed).
BUZZ_RELAY_URL=ws://localhost:3000

# Public NostrWolfe marketplace relay. Read-only in v1.
WOLFE_RELAY_URL=wss://agents.lightningenable.com

# Services channel name — the match/create key, and an input to the
# deterministic channel UUID.
BRIDGE_CHANNEL_NAME=Services

# `about` tag used when the bridge creates the channel.
BRIDGE_CHANNEL_ABOUT=NostrWolfe marketplace mirror — public agent service listings

# Comma-separated service-category allowlist. Empty = mirror everything.
# Applied client-side so category exits can be detected and delisted.
MIRROR_CATEGORIES=

# Normalize listings that don't use NIP-A5 tags (category/pricing instead of
# s/price). Most of the live relay is published this way by third parties, so
# "false" makes the bridge strictly spec-compliant and mirrors far less.
# Normalized listings are labelled as such on their cards.
MIRROR_ACCEPT_DIALECTS=true

# Cap on distinct listing addresses tracked. Overflow is logged and skipped.
MIRROR_MAX_LISTINGS=200

# Age (days) past which an active, unrefreshed listing is flagged by the daily
# staleness sweep (posts a digest note in the channel).
STALE_LISTING_DAYS=30

# Page size for the paged hydration REQ against the wolfe relay.
BACKFILL_LIMIT=100

# Self-imposed publish budget toward the Buzz relay (relay allows 60/min).
BUZZ_MSGS_PER_MIN=30

# Flat JSON state file (cursors, channel id, dedupe metadata).
STATE_FILE=./bridge-state.json

# debug | info | warn | error
LOG_LEVEL=info
